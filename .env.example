# Automatic metrics refresh interval. Use 0 to disable it.
AUTO_REFRESH_HOURS=6
COOKIE_SECURE=false
SEED_DEMO_DATA=false

# Local defaults. Production should use PostgreSQL and Redis service URLs.
DATABASE_URL=sqlite:///social_intelligence.db
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
PUBLIC_PREVIEW_ENABLED=true
PUBLIC_PREVIEW_DAILY_LIMIT=2
PUBLIC_PREVIEW_MAX_CHANNELS=100
# DATABASE_URL=postgresql+psycopg://signaldesk:change-me@localhost:5432/signaldesk

# YouTube Data API v3 server key
YOUTUBE_API_KEY=

# Budget giornaliero stimato della quota YouTube (default console Google: 10000).
# Le operazioni che superano la stima residua vengono bloccate con 503.
YOUTUBE_DAILY_QUOTA=10000

# Ore oltre le quali un job "running" viene marcato come fallito (crash worker).
JOB_TIMEOUT_HOURS=6

# Motore semantico: tfidf (default, nessuna dipendenza) oppure embeddings.
SEMANTIC_ENGINE=tfidf
SEMANTIC_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Label LLM opzionali. URL completo OpenAI-compatible /chat/completions.
SEMANTIC_LABEL_LLM_URL=
SEMANTIC_LABEL_LLM_API_KEY=
SEMANTIC_LABEL_LLM_MODEL=
SEMANTIC_LABEL_LLM_TIMEOUT=10

# Protezione brute-force su login/registrazione: tentativi per finestra,
# durata finestra e lockout base (raddoppia a ogni sforamento, max 3600s).
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOCKOUT_SECONDS=300

# Generate a different random value for each environment.
PSEUDONYM_SALT=
