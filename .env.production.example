APP_ENV=production
DEPLOY_DOMAIN=signaldesk.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=signaldesk
POSTGRES_USER=signaldesk
POSTGRES_PASSWORD=replace-with-a-long-random-password

COOKIE_SECURE=true
SEED_DEMO_DATA=false
RUN_INLINE_WORKER=false
ALLOW_REGISTRATION=false
AUTO_REFRESH_HOURS=6
PUBLIC_ORIGIN=https://signaldesk.example.com
ALLOWED_HOSTS=signaldesk.example.com,localhost,app
PUBLIC_PREVIEW_ENABLED=false
PUBLIC_PREVIEW_DAILY_LIMIT=2
PUBLIC_PREVIEW_MAX_CHANNELS=100

YOUTUBE_API_KEY=
PSEUDONYM_SALT=replace-with-a-long-random-secret

SEMANTIC_ENGINE=tfidf
SEMANTIC_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_LABEL_LLM_URL=
SEMANTIC_LABEL_LLM_API_KEY=
SEMANTIC_LABEL_LLM_MODEL=
SEMANTIC_LABEL_LLM_TIMEOUT=10
